{
  "name": "multi-store-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/retry.test.ts tests/security.test.ts tests/mock-adapters.test.ts tests/orchestrator.test.ts tests/metrics.test.ts tests/timezone.test.ts tests/aggregation.test.ts tests/mapping.test.ts",
    "mock:sync": "tsx scripts/mock-sync.ts",
    "metrics:rebuild": "tsx scripts/rebuild-metrics.ts",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "dotenv": "17.4.2",
    "lucide-react": "1.45.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}

